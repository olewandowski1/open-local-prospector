{
  "name": "open-local-prospector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4310",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4310",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check:biome": "biome check .",
    "check:architecture": "tsx src/architecture/feature-boundaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:check": "tsx src/worker/main.ts --check",
    "check": "pnpm check:biome && pnpm check:architecture && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "3.22.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lefthook": "2.1.10",
    "shadcn": "4.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
