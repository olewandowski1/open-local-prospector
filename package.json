{
  "name": "open-local-prospector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx src/features/local-application/setup/main.ts",
    "dev": "concurrently --kill-others --names web,worker \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "next dev --hostname 127.0.0.1 --port 4310",
    "dev:worker": "node --watch --env-file-if-exists=.env.local --import tsx src/worker/main.ts",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4310",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check:biome": "biome check .",
    "check:architecture": "tsx src/architecture/feature-boundaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:check": "node --env-file-if-exists=.env.local --import tsx src/worker/main.ts --check",
    "db:generate": "drizzle-kit generate",
    "check": "pnpm check:biome && pnpm check:architecture && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "3.22.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "lefthook": "2.1.10",
    "shadcn": "4.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "lefthook"
    ]
  }
}
